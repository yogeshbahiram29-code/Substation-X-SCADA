# Copy this file to ".env" and fill in your key. Never share or commit the .env file.

# Your Claude API key from https://platform.claude.com/ (starts with "sk-ant-").
ANTHROPIC_API_KEY=

# Port the app runs on. Open http://localhost:3000 in your browser.
PORT=3000

# 127.0.0.1 = only this computer can open the app (safest).
# 0.0.0.0   = other computers on the office network can open it too.
HOST=127.0.0.1
